(defpackage #:cl-pdfocr-tests (:use #:cl) (:export #:run-tests))
(in-package #:cl-pdfocr-tests)

(defclass fixture-adapter (vlm:adapter)
  ((calls :initform 0 :accessor calls) (releases :initform 0 :accessor releases)
   (fail :initarg :fail :initform nil :reader fail-p)))
(defmethod vlm:adapter-manifest ((a fixture-adapter))
  (declare (ignore a))
  (vlm:make-model-manifest :family :fixture :architecture "test-only"
    :checkpoint "not-a-real-model" :revision "v1"
    :capabilities (vlm:make-model-capabilities :modalities '(:text :image)
                   :operations '(:generate) :dtypes '(:float32)
                   :context-length 4096 :max-images 1)))
(defmethod vlm:prepare-generation ((a fixture-adapter) messages budget)
  (declare (ignore messages budget)) (incf (calls a)) (list :owned))
(defmethod vlm:generate-prepared ((a fixture-adapter) prepared)
  (declare (ignore prepared))
  (when (fail-p a) (error "Injected generation failure"))
  (vlm:make-generation-result (format nil "```markdown~%Per-~%```") #(1 2) :length))
(defmethod vlm:release-prepared ((a fixture-adapter) prepared)
  (assert (equal prepared '(:owned))) (incf (releases a)))

(defun must-error (function)
  (assert (handler-case (progn (funcall function) nil) (error () t))))

(defun run-tests ()
  (assert (= 3 (cl-pdfocr:levenshtein-distance "kitten" "sitting")))
  (assert (= 1 (cl-pdfocr:levenshtein-distance "ſon" "son")))
  (assert (= 2 (cl-pdfocr:levenshtein-distance #() #(1 2))))
  #+sbcl
  (let ((modes (sb-int:get-floating-point-modes)))
    (cl-pdfocr::with-rasterizer-float-environment
      (assert (not (member :invalid (getf (sb-int:get-floating-point-modes) :traps)))))
    (assert (equal modes (sb-int:get-floating-point-modes))))
  (let ((raw (format nil "  ```markdown~%Fraktur ſ~%```  ")))
    (multiple-value-bind (body start end) (cl-pdfocr:clean-markdown raw)
      (assert (equal body "Fraktur ſ")) (assert (equal body (subseq raw start end)))))
  (assert (equal "abc ``` quoted" (cl-pdfocr:clean-markdown "abc ``` quoted")))
  (assert (equal "Person." (cl-pdfocr:checked-boundary-join "Per-" "son." 34 35 "Per-" "son")))
  (must-error (lambda () (cl-pdfocr:checked-boundary-join "Per-" "ion." 34 35 "Per-" "son")))
  (must-error (lambda () (cl-pdfocr:checked-boundary-join "Per-" "son." 34 36 "Per-" "son")))
  (let* ((root (merge-pathnames (format nil "pdfocr-tests-~D-~D/" (get-universal-time) (random 1000000))
                               (uiop:temporary-directory)))
         (prepared (merge-pathnames "prepared/" root))
         (image (merge-pathnames "page.png" prepared))
         (output (merge-pathnames "ocr/" root)) (adapter (make-instance 'fixture-adapter)))
    (unwind-protect
         (progn
           (cl-pdfocr::write-text image "test-only stand-in; never passed to a real model")
           (uiop:with-current-directory (root)
             (cl-pdfocr::write-text #P"relative/record.txt" "relative paths work")
             (assert (equal "relative paths work" (uiop:read-file-string #P"relative/record.txt"))))
           (cl-pdfocr::write-json (merge-pathnames "document.json" prepared)
             (cl-pdfocr::object "pages" (vector (cl-pdfocr::object "page" 34 "image" "page.png"
                                                 "image_sha256" (cl-pdfocr::sha256 image)))))
           (cl-pdfocr:recognize-prepared prepared output adapter :max-new-tokens 2)
           (assert (= 1 (calls adapter))) (assert (= 1 (releases adapter)))
           (assert (not (probe-file (merge-pathnames ".running" output))))
           (let* ((record (cl-pdfocr::read-json (merge-pathnames "page-0034.json" output)))
                  (run (cl-pdfocr::read-json (merge-pathnames "run.json" output))))
             (assert (equal "partial" (gethash "status" record)))
             (assert (equal "needs-review" (gethash "status" run)))
             (assert (equal (gethash "markdown" record)
                            (subseq (gethash "raw" record) (gethash "source_start" record)
                                    (gethash "source_end" record)))))
           (cl-pdfocr:recognize-prepared prepared output adapter :max-new-tokens 2 :resume t)
           (assert (= 1 (calls adapter)))
           (let* ((path (merge-pathnames "page-0034.json" output))
                  (record (cl-pdfocr::read-json path))
                  (changed (cl-pdfocr::read-json path)))
             (setf (gethash "raw" changed) "edited OCR")
             (cl-pdfocr::write-json path changed)
             (must-error (lambda () (cl-pdfocr:recognize-prepared prepared output adapter
                                       :max-new-tokens 2 :resume t)))
             (cl-pdfocr::write-json path record))
           (must-error (lambda () (cl-pdfocr:recognize-prepared prepared output adapter
                                     :max-new-tokens 3 :resume t)))
           (let* ((failed (make-instance 'fixture-adapter :fail t))
                  (failed-out (merge-pathnames "failure/" root)))
             (cl-pdfocr:recognize-prepared prepared failed-out failed)
             (assert (= 1 (releases failed)))
             (assert (equal "error" (gethash "status" (cl-pdfocr::read-json
                                                      (merge-pathnames "page-0034.json" failed-out))))))
           (cl-pdfocr::write-text image "tampered pixels")
           (must-error (lambda () (cl-pdfocr:recognize-prepared prepared output adapter
                                     :max-new-tokens 2 :resume t)))
           (assert (not (probe-file (merge-pathnames ".running" output)))))
      (uiop:delete-directory-tree root :validate t :if-does-not-exist :ignore)))
  (format t "~&PASS: distance/Unicode, exact body slices, guarded joins, partial/error records, request cleanup, resume identity and pixel tamper rejection.~%")
  t)
