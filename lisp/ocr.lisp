;;; Small first-use command. All inference is explicitly delegated to Ollama.
(require :asdf)
(defun usage ()
  (format t "Usage: sbcl --script lisp/ocr.lisp BOOK.pdf OUTPUT/ [--model NAME] [--pages 1,2] [--dpi 200] [--tokens 2048] [--resume]~%"))
(when (or (null (uiop:command-line-arguments))
          (member "--help" (uiop:command-line-arguments) :test #'equal))
  (usage) (uiop:quit 0))
(load (merge-pathnames "load.lisp" *load-truename*))
(asdf:load-system "cl-pdfocr/ollama")
(handler-case
    (let* ((args (uiop:command-line-arguments)) (source (pop args)) (out (pop args))
           (model "gemma4:12b") (pages '(1 2)) (dpi 200) (tokens 2048) (resume nil))
      (unless out (error "Supply both the PDF and an output directory."))
      (loop while args for option = (pop args)
            do (cond
                 ((equal option "--resume") (setf resume t))
                 ((member option '("--model" "--pages" "--dpi" "--tokens") :test #'equal)
                  (let ((value (or (pop args) (error "Missing value for ~A." option))))
                    (cond ((equal option "--model") (setf model value))
                          ((equal option "--pages")
                           (setf pages (mapcar #'parse-integer (uiop:split-string value :separator ","))))
                          ((equal option "--dpi") (setf dpi (parse-integer value)))
                          ((equal option "--tokens") (setf tokens (parse-integer value))))))
                 (t (error "Unknown option: ~A" option))))
      (cl-pdfocr:convert-ollama-pdf source out model :pages pages :dpi dpi
                                   :max-new-tokens tokens :resume resume)
      (let* ((directory (uiop:ensure-directory-pathname out))
             (run (cl-pdfocr::read-json (merge-pathnames "ocr/run.json" directory)))
             (status (gethash "status" run)))
        (format t "~&Backend: Lisp orchestration / local Ollama inference~%Model: ~A~%Status: ~A~%Markdown: ~A~%"
                model status (merge-pathnames "ocr/reading.md" directory))
        (unless (equal "complete" status)
          (format t "Inspect ocr/page-*.json for partial output or errors. Use a fresh directory for a larger token budget.~%")
          (uiop:quit 2))))
  (error (condition) (format *error-output* "~&OCR failed: ~A~%" condition) (uiop:quit 1)))
